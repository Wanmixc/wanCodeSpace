RUN chown -R ubuntu:ubuntu /home/ubuntu/.config/nvim

# Pre-install plugins, treesitter parsers and the Lua language server, so the
# first `nvim` in the container starts fully set up and needs no network.
USER ubuntu
RUN export HOME=/home/ubuntu \
    && nvim --headless \
        "+lua require('nvim-treesitter').install({ 'lua', 'vim', 'vimdoc', 'query', 'markdown', 'markdown_inline', 'diff', 'python', 'bash', 'json', 'yaml', 'toml', 'c', 'javascript', 'typescript', 'tsx', 'html', 'css', 'go', 'rust' }):wait(900000)" \
        "+lua local r = require('mason-registry'); vim.wait(300000, function() return r.has_package('lua-language-server') end, 1000); local p = r.get_package('lua-language-server'); if not p:is_installed() then pcall(p.install, p) end; vim.wait(600000, function() return p:is_installed() end, 1000); vim.wait(15000)" \
        "+qa"
USER root

# Fail the build if the pre-installed pieces are missing.
RUN test -x /home/ubuntu/.local/share/nvim/mason/bin/lua-language-server \
    && test -f /home/ubuntu/.local/share/nvim/site/parser/lua.so \
    && test -d /home/ubuntu/.local/share/nvim/site/pack/core/opt/mini.nvim \
    && echo "Neovim 0.13 config, treesitter parsers and lua_ls are preinstalled"

# Install OpenCode for the ubuntu user. --no-modify-path keeps PATH handling in
# config.fish above instead of appending a duplicate fish_add_path line.
USER ubuntu
RUN export HOME=/home/ubuntu \
    && curl -fsSL https://opencode.ai/v2/install | bash -s -- --no-modify-path \
    && fish -lc 'if not command -q opencode; echo "opencode not found on fish PATH" >&2; exit 1; end; opencode --version' \
    && fish -lc 'if not command -q gitui; echo "gitui not found on fish PATH" >&2; exit 1; end; gitui --version'
USER root

# Also expose OpenCode to non-fish shells (bash, sh, VS Code tasks).
ENV PATH="/home/ubuntu/.opencode/bin:${PATH}"
